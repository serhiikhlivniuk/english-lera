  {
    "id": "simple-vs-continuous",
    "group": "Tenses",
    "title": "Present Simple or Present Continuous?",
    "uk": "every day чи right now",
    "level": "A2",
    "summary": "The most common choice in NMT grammar tasks: a habit or something happening now?",
    "lessons": [
      "lesson-02"
    ],
    "rules": [
      {
        "name": "Present Simple = always / usually",
        "form": "habits · routines · facts · timetables",
        "when": "Time words: every day, usually, often, never, on Mondays.",
        "examples": [
          {
            "en": "My dad usually drinks tea.",
            "uk": "Тато зазвичай пʼє чай."
          },
          {
            "en": "She works in a bank.",
            "uk": "Вона працює в банку."
          }
        ]
      },
      {
        "name": "Present Continuous = now / for a short time",
        "form": "now · at the moment · today · this week · Look!",
        "when": "Something in progress, or a temporary situation.",
        "examples": [
          {
            "en": "Today he is drinking coffee.",
            "uk": "Сьогодні він пʼє каву."
          },
          {
            "en": "She is working from home this week.",
            "uk": "Цього тижня вона працює з дому."
          }
        ]
      },
      {
        "name": "State verbs: no -ing",
        "form": "like · love · hate · want · know · understand · need · believe · have (= own)",
        "when": "These verbs describe feelings, thoughts and possession, not actions — use the Present Simple even with now.",
        "examples": [
          {
            "en": "I know the answer now.",
            "uk": "Тепер я знаю відповідь."
          },
          {
            "en": "She wants a new phone.",
            "uk": "Вона хоче новий телефон."
          }
        ]
      }
    ],
    "mistakes": [
      {
        "wrong": "I am knowing him.",
        "right": "I know him.",
        "note": "know is a state verb"
      },
      {
        "wrong": "Look! He plays football.",
        "right": "Look! He is playing football.",
        "note": "Look! = now"
      },
      {
        "wrong": "She is going to the gym every day.",
        "right": "She goes to the gym every day.",
        "note": "every day = habit"
      }
    ],
    "quiz": [
      {
        "q": "My sister ___ to school by bus every day.",
        "options": [
          "is going",
          "goes",
          "go"
        ],
        "answer": 1
      },
