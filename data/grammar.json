        "examples": [
          {
            "en": "I'm doing my homework now.",
            "uk": "Я зараз роблю домашку."
          },
          {
            "en": "My mum is cooking dinner.",
            "uk": "Мама готує вечерю."
          }
        ]
      },
      {
        "name": "Negatives and questions",
        "form": "I'm not · she isn't · they aren't + V-ing  ·  Am / Is / Are + subject + V-ing?",
        "when": "No do / does here — to be does all the work.",
        "examples": [
          {
            "en": "He isn't listening.",
            "uk": "Він не слухає."
          },
          {
            "en": "Are you watching TV? — No, I'm not.",
            "uk": "Ти дивишся телевізор? — Ні."
          }
        ]
      },
      {
        "name": "Time words",
        "form": "now · right now · at the moment · today · this week · Look! · Listen!",
        "when": "These words usually tell you to choose the Present Continuous.",
        "examples": [
          {
            "en": "Look! It's snowing.",
            "uk": "Дивись! Іде сніг."
          },
          {
            "en": "This week she is staying with her grandma.",
            "uk": "Цього тижня вона живе в бабусі."
          }
        ]
      }
    ],
    "mistakes": [
      {
        "wrong": "She cooking now.",
        "right": "She is cooking now.",
        "note": "is cannot be skipped"
      },
      {
        "wrong": "I am work now.",
        "right": "I am working now.",
        "note": "am needs -ing after it"
      },
      {
        "wrong": "Do you listening?",
        "right": "Are you listening?",
        "note": "no do in the Present Continuous"
      }
    ],
    "quiz": [
      {
        "q": "Be quiet! The baby ___.",
        "options": [
          "sleeps",
          "is sleeping",
          "sleeping"
        ],
        "answer": 1
      },
      {
        "q": "We ___ for the bus at the moment.",
        "options": [
          "are waiting",
          "waiting",
          "wait"
        ],
        "answer": 0
      },
      {
        "q": "___ your brother playing football now?",
        "options": [
          "Does",
          "Is",
          "Do"
        ],
        "answer": 1
      },
      {
        "q": "I ___ TV right now — I'm reading.",
        "options": [
          "don't watch",
          "am not watching",
          "not watching"
        ],
        "answer": 1
