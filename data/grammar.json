      {
        "q": "write →",
        "options": [
          "writting",
          "writing",
          "writeing"
        ],
        "answer": 1,
        "why": "Drop the -e. Only one t: writing."
      },
      {
        "q": "swim →",
        "options": [
          "swimming",
          "swiming",
