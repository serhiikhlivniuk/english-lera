  {
    "id": "ing-spelling",
    "group": "Tenses",
    "title": "Spelling: -ing",
    "uk": "make → making, swim → swimming",
    "level": "A1",
    "summary": "Three small rules for adding -ing.",
    "lessons": [
      "lesson-02"
    ],
    "rules": [
      {
        "name": "Most verbs",
        "form": "V + -ing",
        "when": "Just add -ing.",
        "examples": [
          {
            "en": "play → playing, read → reading",
            "uk": ""
          }
        ]
      },
      {
        "name": "Silent -e",
        "form": "-e → -ing",
        "when": "Drop the e at the end.",
        "examples": [
          {
            "en": "make → making, write → writing, dance → dancing",
            "uk": ""
          }
        ]
      },
      {
        "name": "Short verbs: vowel + consonant",
        "form": "double the last letter",
        "when": "One vowel + one consonant at the end of a short verb.",
        "examples": [
          {
            "en": "swim → swimming, sit → sitting, get → getting, run → running",
            "uk": ""
          }
        ]
      },
      {
        "name": "-ie",
        "form": "-ie → -ying",
        "when": "A small group of verbs.",
        "examples": [
          {
            "en": "lie → lying, die → dying",
            "uk": ""
          }
        ]
      }
    ],
    "mistakes": [
      {
        "wrong": "writeing",
        "right": "writing",
        "note": "drop the -e"
      },
      {
        "wrong": "swiming",
        "right": "swimming",
        "note": "double the m"
      },
      {
        "wrong": "studing",
        "right": "studying",
        "note": "keep the y before -ing"
      }
    ],
    "quiz": [
      {
        "q": "make →",
        "options": [
          "makeing",
          "making",
          "makking"
        ],
        "answer": 1
      },
      {
        "q": "sit →",
        "options": [
          "siting",
          "sitting",
          "sitteing"
        ],
        "answer": 1
      },
      {
        "q": "study →",
        "options": [
          "studing",
          "studiing",
          "studying"
        ],
        "answer": 2
      }
    ],
    "practice": [
      {
        "q": "dance →",
        "options": [
          "danceing",
          "dancing",
          "danccing"
        ],
        "answer": 1,
        "why": "Silent -e: drop it → dancing."
