      {
        "q": "run →",
        "options": [
          "runing",
          "running",
          "runeing"
        ],
        "answer": 1,
        "why": "Short verb, one vowel + one consonant → double n."
      },
      {
        "q": "play →",
        "options": [
          "playing",
          "plaing",
          "playying"
        ],
        "answer": 0,
        "why": "y after a vowel stays: playing."
      },
      {
        "q": "lie →",
        "options": [
          "lieing",
          "liing",
          "lying"
        ],
